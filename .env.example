# Duskrun docker-compose configuration. Copy to `.env` and fill in secrets:
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# --- duskrun (required) ---
#
# Both are left EMPTY on purpose. `docker compose up` refuses to start until you
# fill them in, and duskrun itself refuses to serve if it finds the example text
# in either. A credential committed to a public repository protects nothing, and
# an instance running with one looks exactly like an instance that is secured —
# so neither is allowed to have a working default.
#
# Master key that wraps all stored secrets (envelope encryption). Losing it
# means losing every stored secret: back it up somewhere other than this host.
#   openssl rand -base64 48
DUSKRUN_MASTER_KEY=
# Static bearer token for the REST API (Authorization: Bearer <token>). It is a
# machine account with admin rights, and the only way in before the first user
# exists (`duskrun user add`).
#   openssl rand -hex 32
DUSKRUN_API_TOKEN=

# --- duskrun (optional, shown with defaults) ---
DUSKRUN_PORT=8080
DUSKRUN_WORKERS=4
DUSKRUN_LOG_FORMAT=json
# Set to true only when duskrun really sits behind a reverse proxy: it makes
# login throttling key on X-Forwarded-For. Left false, a caller could pick its
# own throttle bucket by sending the header itself.
DUSKRUN_TRUSTED_PROXY=false

# --- demo profile: sample Postgres ---
DEMO_PG_USER=backup
DEMO_PG_PASSWORD=backup
DEMO_PG_DB=orders_db
DEMO_PG_PORT=5432

# --- demo profile: sample MySQL ---
DEMO_MYSQL_ROOT_PASSWORD=rootpw
DEMO_MYSQL_USER=backup
DEMO_MYSQL_PASSWORD=backup
DEMO_MYSQL_DB=analytics_db
DEMO_MYSQL_PORT=3306

# demo MongoDB (профиль demo)
DEMO_MONGO_USER=backup
DEMO_MONGO_PASSWORD=backup
DEMO_MONGO_DB=catalog_db
DEMO_MONGO_PORT=27017

# demo Redis (профиль demo) — пароль через requirepass, логина нет
DEMO_REDIS_PASSWORD=backup
DEMO_REDIS_PORT=6379

# demo SFTP (профиль demo) — только ключевая аутентификация:
# публичный ключ кладётся в ./demo/sftp/keys/*.pub, приватный — в секреты duskrun
DEMO_SFTP_USER=backup
DEMO_SFTP_PORT=2222

# --- demo profile: MinIO (S3-compatible) ---
DEMO_S3_ACCESS_KEY=minioadmin
DEMO_S3_SECRET_KEY=minioadmin
DEMO_S3_BUCKET=backups
DEMO_S3_PORT=9000
DEMO_S3_CONSOLE_PORT=9001

# --- demo profile: Mailpit (local SMTP sink for the email notifier) ---
DEMO_SMTP_USER=duskrun
DEMO_SMTP_PASSWORD=duskrun
DEMO_SMTP_PORT=1025
DEMO_SMTP_UI_PORT=8025
