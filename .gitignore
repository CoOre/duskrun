# Build output. `dist/duskrun` used to be committed — a 15 MB binary that
# nobody could tell was stale, built from a dirty tree on an old toolchain.
/bin/
/dist/

# Dependencies and tool caches.
node_modules/

*.db
*.db-wal
*.db-shm
.env
.DS_Store
run-*.log

# Built SPA bundle. Entirely generated by `make ui` / `make release` / Docker.
# Only .gitkeep is tracked, so go:embed still has a directory to embed in a
# fresh checkout; a binary built without the frontend step serves
# internal/web/placeholder.html instead. Committing the generated index.html
# here is what used to ship binaries whose asset URLs 404'd.
internal/web/dist/*
!internal/web/dist/.gitkeep

# Внутренние рабочие материалы: макеты, планы, ТЗ. Живут локально, в публичный
# репозиторий не попадают.
/artifacts/
/docs/
/PLAN.md
/PLAN-M6-UI.md
/PROGRESS.md
